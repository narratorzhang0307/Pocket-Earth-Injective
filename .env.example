# 将本文件另存为 .env 并填入下面两个 key

# Mapbox access token（地图底图）。申请：https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# ——— 云脑（agent 的大脑，只在服务端用，不进前端 bundle）———
# auto：Microsoft Foundry Model Router 配齐时优先，失败自动回落 Qwen；也可显式填 azure 或 qwen。
FROST_LLM_PROVIDER=auto

# Microsoft Foundry Model Router（部署一个 model-router 后填写；API 版本按微软官方 Chat Completions 示例）。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=model-router
AZURE_OPENAI_API_VERSION=2024-10-21

# Qwen fallback（阿里云百炼 DashScope · OpenAI 兼容接口）。
# 申请：https://bailian.console.aliyun.com/  （开通后在「API-KEY」处获取）
DASHSCOPE_API_KEY=
# 云脑模型 id（以百炼控制台为准）：qwen-plus（稳，默认）/ qwen-max / qwen3.6-plus / qwen-turbo …
QWEN_MODEL=qwen-plus
# DashScope 接入点：国内默认；新加坡用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 未配 DASHSCOPE_API_KEY 时，云脑自动走规则 fallback，UI 照常工作（不依赖任何第三方模型）。

# 端侧模型（做选歌 / 选图 / 分类 / 嵌入 / 视觉打标）。不填用默认；都不可达时自动走规则兜底。
# 后端选择：auto(默认，优先 MNN 再 ollama 再 stub) | mnn | ollama | stub
EDGE_BACKEND=auto

# MNN sidecar（端侧 MNN-LLM 推理，推荐的端侧后端，部署见 deploy/edge-runtime/）。
# 留空则不启用 MNN（auto 时回落 ollama/stub）；起了 sidecar 后填它的地址即可切端侧、前端不改。
MNN_URL=
# 模型路径在 sidecar 侧配置(deploy/edge-runtime/serve.sh)，不在这里。

# ollama 本机后端（备选，本机 demo 用）。
OLLAMA_URL=http://localhost:11434
EDGE_MODEL=qwen3:0.6b
EDGE_VISION_MODEL=qwen2.5vl:3b

# ——— Injective（链上 agent 身份 / 社交握手，仅服务端用，绝不进前端 bundle）———
# Injective testnet EVM 私钥（0x…，仅 testnet、勿用主网密钥）。真上链注册 / 握手必需；只读发现功能不需要。
# 用该地址去水龙头领 testnet INJ 付 gas：https://testnet.faucet.injective.network/
INJ_PRIVATE_KEY=
# 网络：默认 testnet（chainId 1439）。
INJ_NETWORK=testnet
# 已部署的 SocialHandshake 合约地址（部署见 INJECTIVE-INTEGRATION/deploy-handshake.mjs）；配了才能真握手上链。
INJ_HANDSHAKE_CONTRACT=
# 已部署的 DailyKnowledgeChronicle（公开地址，不是密钥）。
INJ_CHRONICLE_CONTRACT=0x3f0e5daeb81eea1b41ca80ae483acdb8de0f0c25
# Pinata JWT（可选）——把 Agent Card 传 IPFS；不配则用 data: URI 内联口味名片（无需外部托管，默认）。
PINATA_JWT=

# ——— Frost Edge Node（公开事件 feed；服务端与 Pi 使用同一随机 token）———
# 建议生成：openssl rand -hex 32。不要提交真实值，不要用 VITE_ 前缀。
FROST_FEED_TOKEN=

# 手工刷新公共知识的管理员 token；未配置时仅允许本机回环地址调用 refresh。
KNOWLEDGE_ADMIN_TOKEN=
