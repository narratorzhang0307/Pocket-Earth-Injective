[Unit]
Description=Pocket Earth AhaKey Bluetooth Auto-Reconnect
Wants=bluetooth.target
After=bluetooth.target
ConditionPathExists=/home/pi/pocket-earth/frost_pi_ahakey_reconnect.py

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pocket-earth
Environment=PYTHONUNBUFFERED=1
Environment=AHAKEY_MAC=D4:6C:50:5C:F6:93
ExecStart=/usr/bin/python3 -u /home/pi/pocket-earth/frost_pi_ahakey_reconnect.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
